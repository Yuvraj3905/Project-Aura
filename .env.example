# Copy to .env. Defaults match docker-compose service names + ports.

# --- Postgres ---
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura
POSTGRES_DB=aura
# In-container connection (services talk to the `postgres` service on 5432).
DATABASE_URL=postgresql://aura:aura@postgres:5432/aura
# From the host (e.g. local scripts) use the mapped port 5440.
DATABASE_URL_HOST=postgresql://aura:aura@localhost:5440/aura

# --- Ollama ---
OLLAMA_HOST=http://ollama:11434
# Model tag. For faster answers on CPU, pull + use a smaller model, e.g.:
#   docker compose exec ollama ollama pull llama3.2:3b   (then set OLLAMA_MODEL=llama3.2:3b)
OLLAMA_MODEL=llama3:8b
# Inference speed knobs (see ml-service/app/config.py):
OLLAMA_NUM_CTX=4096        # context window; must hold system prompt + top_k chunks + query
OLLAMA_NUM_PREDICT=512     # max generated tokens (caps answer length / runaway generation)
OLLAMA_KEEP_ALIVE=30m      # keep model resident between requests (skip reload cost)

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- ml-service ---
ML_SERVICE_URL=http://ml-service:8100

# --- RAG tuning ---
CHUNK_TOKENS=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.45

# --- Rasa ---
RASA_URL=http://rasa:5105

# --- Dashboard auth (optional) ---
# Leave empty for loopback-only access (web is bound to 127.0.0.1).
# Set a strong value to allow LAN/remote callers that send `x-dashboard-token: <value>`.
DASHBOARD_TOKEN=

# --- Cost analytics (dashboard "what would ChatGPT cost") ---
# OpenAI/ChatGPT prices in USD per 1,000,000 tokens (input,output). Used only to
# estimate the bill for the same token volume Aura ran locally for free. Edit to match
# current OpenAI pricing. Format per model: "input_per_million,output_per_million".
OPENAI_PRICE_GPT_4O=2.50,10.00
OPENAI_PRICE_GPT_4O_MINI=0.15,0.60
OPENAI_PRICE_GPT_35_TURBO=0.50,1.50
